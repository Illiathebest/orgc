---
# Найсуворіший профіль ansible-lint
profile: production

exclude_paths:
  - .cache/
  - .gitlab-ci.yml
  - ci/
  - bootstrap/
  - terraform/
  - examples/      # моделі organization.yml — валідуються JSON-схемою, не ansible-lint
  - orgc/          # модуль Go: схема, код і тестові моделі. Серед них є
                   # навмисно нерозбірний YAML (негативний приклад для S001),
                   # на якому ansible-lint дає load-failure.
  - docs/

kinds:
  - playbook: ansible/playbooks/*.yml
  - inventory: ansible/inventories/**/hosts.yml
  - vars: ansible/inventories/**/group_vars/**/*.yml
  - vars: ansible/inventories/**/host_vars/**/*.yml
  - requirements: ansible/requirements.yml
