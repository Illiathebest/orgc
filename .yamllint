---
extends: default

rules:
  line-length:
    max: 160
    level: warning
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  braces:
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
  truthy:
    allowed-values: ["true", "false"]

ignore: |
  .cache/
  .terraform/
  ansible/collections/
  # Навмисно нерозбірний YAML — негативний приклад для коду S001.
  # Решта фікстур у testdata/ є коректним YAML і лінтується як звичайно.
  orgc/testdata/broken/s001-bad-yaml.yml
