# Скопіюй цей файл у .env поруч (cp .env.example .env) і відредагуй за потреби.
# .env знаходиться у .gitignore — він НЕ потрапляє в Git.

# IP-адреса VM ctrl-01 у домашній LAN (статична, з cloud-init)
GITLAB_HOST=192.168.1.50

# Каталоги даних на ctrl-01 (bind mounts)
GITLAB_HOME=/srv/gitlab
RUNNER_HOME=/srv/gitlab-runner

TZ=Europe/Kyiv
