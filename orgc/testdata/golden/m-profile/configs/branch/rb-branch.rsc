# Generated by orgc from m-profile.yml. Do not edit by hand.
# Device rb-branch (edge_router), site branch, RouterOS 6.48.
# Import on a device reset with no default configuration (/system reset-configuration no-defaults=yes).

/system identity
set name=rb-branch

# Bridge with VLAN filtering and RSTP; filtering is switched on at the end.
/interface bridge
add name=bridge vlan-filtering=no protocol-mode=rstp priority=0x1000 comment=orgc
/interface bridge port
add bridge=bridge interface=ether2 frame-types=admit-only-vlan-tagged ingress-filtering=yes comment="trunk to core-br-01:Ethernet1"
/interface bridge vlan
add bridge=bridge vlan-ids=110 tagged=bridge,ether2 comment=mgmt-branch
add bridge=bridge vlan-ids=120 tagged=bridge,ether2 comment=users-branch
add bridge=bridge vlan-ids=130 tagged=bridge,ether2 comment=servers-branch

# VLAN interfaces and addresses.
/interface vlan
add interface=bridge name=vlan110-mgmt-branch vlan-id=110
add interface=bridge name=vlan120-users-branch vlan-id=120
add interface=bridge name=vlan130-servers-branch vlan-id=130
/ip address
add address=192.168.110.1/24 interface=vlan110-mgmt-branch comment=mgmt-branch
add address=192.168.120.1/24 interface=vlan120-users-branch comment=users-branch
add address=192.168.130.1/24 interface=vlan130-servers-branch comment=servers-branch

# Uplinks: address from the provider, default route; backup with a higher distance.
/interface list
add name=WAN comment=orgc
/interface list member
add list=WAN interface=ether1
add list=WAN interface=ether4
/ip dhcp-client
remove [find interface=ether1]
remove [find interface=ether4]
add interface=ether1 add-default-route=yes default-route-distance=1 use-peer-dns=no disabled=no comment="uplink isp-branch"
add interface=ether4 add-default-route=yes default-route-distance=2 use-peer-dns=no disabled=no comment="uplink lte-branch"

# DHCP servers.
/ip pool
add name=pool-users-branch ranges=192.168.120.100-192.168.120.200
/ip dhcp-server
add name=dhcp-users-branch interface=vlan120-users-branch address-pool=pool-users-branch disabled=no
/ip dhcp-server network
add address=192.168.120.0/24 gateway=192.168.120.1 comment=users-branch

# Networks of the model: what any means in a rule.
/ip firewall address-list
add list=orgc-networks address=192.168.10.0/24 comment=mgmt
add list=orgc-networks address=192.168.20.0/24 comment=users
add list=orgc-networks address=192.168.30.0/24 comment=servers
add list=orgc-networks address=192.168.40.0/24 comment=guest
add list=orgc-networks address=192.168.110.0/24 comment=mgmt-branch
add list=orgc-networks address=192.168.120.0/24 comment=users-branch
add list=orgc-networks address=192.168.130.0/24 comment=servers-branch

# Input: traffic to the gateway itself. Default deny.
/ip firewall filter
add chain=input action=accept connection-state=established,related comment="established, related"
add chain=input action=drop connection-state=invalid comment=invalid
add chain=input action=accept src-address=192.168.30.0/24 dst-address=192.168.110.1 protocol=tcp dst-port=8728 comment="management from servers"
add chain=input action=accept src-address=192.168.30.0/24 dst-address=192.168.110.1 protocol=tcp dst-port=22,8728 comment="servers -> mgmt-branch"
add chain=input action=accept src-address=192.168.120.0/24 dst-address=192.168.130.1 protocol=tcp dst-port=22,443 comment="users-branch -> servers-branch"
add chain=input action=accept protocol=udp dst-port=67 in-interface=vlan120-users-branch comment="dhcp users-branch"
add chain=input action=drop comment="default deny"

# Forward: traffic between networks and to the internet. Default deny.
add chain=forward action=accept connection-state=established,related comment="established, related"
add chain=forward action=drop connection-state=invalid comment=invalid
add chain=forward action=accept src-address=192.168.30.0/24 dst-address=192.168.110.0/24 protocol=tcp dst-port=22,8728 comment="servers -> mgmt-branch"
add chain=forward action=accept src-address=192.168.120.0/24 out-interface-list=WAN comment="users-branch -> internet"
add chain=forward action=accept src-address=192.168.120.0/24 dst-address=192.168.130.0/24 protocol=tcp dst-port=22,443 comment="users-branch -> servers-branch"
add chain=forward action=drop comment="default deny"

# NAT: networks with a rule to the internet.
/ip firewall nat
add chain=srcnat action=masquerade src-address=192.168.120.0/24 out-interface-list=WAN comment="users-branch -> internet"

/interface bridge
set [find name=bridge] vlan-filtering=yes
