# Generated by orgc from m-profile.yml. Do not edit by hand.
# Device rb750 (edge_router), site hq, RouterOS 6.48.
# Import on a device reset with no default configuration (/system reset-configuration no-defaults=yes).

/system identity
set name=rb750

# Bridge with VLAN filtering and RSTP; filtering is switched on at the end.
/interface bridge
add name=bridge vlan-filtering=no protocol-mode=rstp priority=0x1000 comment=orgc
/interface bridge port
add bridge=bridge interface=ether2 frame-types=admit-only-vlan-tagged ingress-filtering=yes comment="trunk to core-01:Ethernet1"
/interface bridge vlan
add bridge=bridge vlan-ids=10 tagged=bridge,ether2 comment=mgmt
add bridge=bridge vlan-ids=20 tagged=bridge,ether2 comment=users
add bridge=bridge vlan-ids=30 tagged=bridge,ether2 comment=servers
add bridge=bridge vlan-ids=40 tagged=bridge,ether2 comment=guest

# VLAN interfaces and addresses.
/interface vlan
add interface=bridge name=vlan10-mgmt vlan-id=10
add interface=bridge name=vlan20-users vlan-id=20
add interface=bridge name=vlan30-servers vlan-id=30
add interface=bridge name=vlan40-guest vlan-id=40
/ip address
add address=192.168.10.1/24 interface=vlan10-mgmt comment=mgmt
add address=192.168.20.1/24 interface=vlan20-users comment=users
add address=192.168.30.1/24 interface=vlan30-servers comment=servers
add address=192.168.40.1/24 interface=vlan40-guest comment=guest

# Uplinks: address from the provider, default route; backup with a higher distance.
/interface list
add name=WAN comment=orgc
/interface list member
add list=WAN interface=ether1
add list=WAN interface=ether4
/ip dhcp-client
remove [find interface=ether1]
remove [find interface=ether4]
add interface=ether1 add-default-route=yes default-route-distance=1 use-peer-dns=no disabled=no comment="uplink isp-main"
add interface=ether4 add-default-route=yes default-route-distance=2 use-peer-dns=no disabled=no comment="uplink lte-backup"

# DHCP servers.
/ip pool
add name=pool-users ranges=192.168.20.100-192.168.20.200
add name=pool-guest ranges=192.168.40.100-192.168.40.200
/ip dhcp-server
add name=dhcp-users interface=vlan20-users address-pool=pool-users disabled=no
add name=dhcp-guest interface=vlan40-guest address-pool=pool-guest disabled=no
/ip dhcp-server network
add address=192.168.20.0/24 gateway=192.168.20.1 comment=users
add address=192.168.40.0/24 gateway=192.168.40.1 comment=guest

# Input: traffic to the gateway itself. Default deny.
/ip firewall filter
add chain=input action=accept connection-state=established,related comment="established, related"
add chain=input action=drop connection-state=invalid comment=invalid
add chain=input action=accept src-address=192.168.30.0/24 dst-address=192.168.10.1 protocol=tcp dst-port=8728 comment="management from servers"
add chain=input action=accept src-address=192.168.30.0/24 dst-address=192.168.10.1 protocol=tcp dst-port=22,8728 comment="servers -> mgmt"
add chain=input action=accept src-address=192.168.20.0/24 dst-address=192.168.30.1 protocol=tcp dst-port=22,443 comment="users -> servers"
add chain=input action=accept protocol=udp dst-port=67 in-interface=vlan20-users comment="dhcp users"
add chain=input action=accept protocol=udp dst-port=67 in-interface=vlan40-guest comment="dhcp guest"
add chain=input action=drop comment="default deny"

# Forward: traffic between networks and to the internet. Default deny.
add chain=forward action=accept connection-state=established,related comment="established, related"
add chain=forward action=drop connection-state=invalid comment=invalid
add chain=forward action=accept src-address=192.168.40.0/24 out-interface-list=WAN comment="guest -> internet"
add chain=forward action=accept src-address=192.168.30.0/24 dst-address=192.168.10.0/24 protocol=tcp dst-port=22,8728 comment="servers -> mgmt"
add chain=forward action=accept src-address=192.168.30.0/24 dst-address=192.168.110.0/24 protocol=tcp dst-port=22,8728 comment="servers -> mgmt-branch"
add chain=forward action=accept src-address=192.168.20.0/24 out-interface-list=WAN comment="users -> internet"
add chain=forward action=accept src-address=192.168.20.0/24 dst-address=192.168.30.0/24 protocol=tcp dst-port=22,443 comment="users -> servers"
add chain=forward action=drop comment="default deny"

# NAT: networks with a rule to the internet.
/ip firewall nat
add chain=srcnat action=masquerade src-address=192.168.20.0/24 out-interface-list=WAN comment="users -> internet"
add chain=srcnat action=masquerade src-address=192.168.40.0/24 out-interface-list=WAN comment="guest -> internet"

/interface bridge
set [find name=bridge] vlan-filtering=yes
