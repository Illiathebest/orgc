{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:orgc:organization-schema",
  "title": "Модель організації (Infrastructure-in-a-Box)",
  "description": "Декларативний опис організації (Organization-as-Data). З цієї моделі компілятор orgc генерує інвентарі та конфігурації. Схема — frontend компілятора; семантику перевіряють інваріанти E001-E008/W001-W003 (ADR-005).",
  "type": "object",
  "additionalProperties": false,
  "required": ["organization", "profile", "sites", "control_node"],
  "properties": {
    "organization": {
      "type": "string",
      "minLength": 1,
      "title": "Назва організації",
      "description": "Людська назва компанії-власника інфраструктури."
    },
    "profile": {
      "title": "Профіль масштабування",
      "description": "S — малий офіс (усе на одному вузлі); M — кілька сайтів. Визначає топологію control plane.",
      "enum": ["S", "M"]
    },
    "sites": {
      "type": "array",
      "minItems": 1,
      "title": "Майданчики (сайти)",
      "description": "Фізичні локації організації. Кожен сайт має власні мережі, пристрої та сервери.",
      "items": { "$ref": "#/$defs/site" }
    },
    "control_node": {
      "title": "Вузол керування",
      "description": "Вузол, з якого застосовуються конфігурації. Початкова вершина для перевірки досяжності управління (E006).",
      "$ref": "#/$defs/control_node"
    },
    "policies": {
      "title": "Політики безпеки",
      "$ref": "#/$defs/policies"
    },
    "modules": {
      "title": "Функціональні модулі",
      "$ref": "#/$defs/modules"
    }
  },
  "$defs": {
    "ipv4": {
      "type": "string",
      "title": "IPv4-адреса",
      "description": "Адреса у форматі a.b.c.d (кожен октет 0–255).",
      "pattern": "^((25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])$"
    },
    "cidr": {
      "type": "string",
      "title": "Мережа у нотації CIDR",
      "description": "Підмережа у форматі a.b.c.d/префікс (префікс 0–32).",
      "pattern": "^((25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])/(3[0-2]|[12]?[0-9])$"
    },
    "identifier": {
      "type": "string",
      "title": "Технічний ідентифікатор",
      "description": "Малі латинські літери, цифри, дефіс та підкреслення; починається з літери.",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "control_node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["site", "network", "ip"],
      "properties": {
        "site": {
          "title": "Сайт вузла керування",
          "description": "Назва сайту, у якому розміщено вузол керування (E003).",
          "$ref": "#/$defs/identifier"
        },
        "network": {
          "title": "Мережа вузла керування",
          "description": "Назва мережі того самого сайту, до якої підключено вузол керування (E003).",
          "$ref": "#/$defs/identifier"
        },
        "ip": {
          "title": "IP-адреса вузла керування",
          "$ref": "#/$defs/ipv4"
        }
      }
    },
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "networks"],
      "properties": {
        "name": {
          "title": "Назва сайту",
          "$ref": "#/$defs/identifier"
        },
        "allow_overlap": {
          "type": "boolean",
          "title": "Дозволити перетин префіксів",
          "description": "true — свідомо знімає перевірку неперетину CIDR у межах цього сайту (E001)."
        },
        "networks": {
          "type": "array",
          "minItems": 1,
          "title": "Мережі сайту (VLAN-сегменти)",
          "items": { "$ref": "#/$defs/network" }
        },
        "uplinks": {
          "type": "array",
          "title": "Зовнішні канали сайту",
          "description": "Канали до провайдерів. Сайт профілю M без каналу kind: backup дає попередження (W003).",
          "items": { "$ref": "#/$defs/uplink" }
        },
        "devices": {
          "type": "array",
          "title": "Мережеві пристрої сайту",
          "items": { "$ref": "#/$defs/device" }
        },
        "servers": {
          "type": "array",
          "title": "Сервери сайту",
          "items": { "$ref": "#/$defs/server" }
        }
      }
    },
    "uplink": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind"],
      "properties": {
        "name": {
          "title": "Назва каналу",
          "$ref": "#/$defs/identifier"
        },
        "kind": {
          "title": "Тип каналу",
          "description": "primary — основний канал; backup — резервний.",
          "enum": ["primary", "backup"]
        }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vlan", "name", "cidr", "role"],
      "properties": {
        "vlan": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4094,
          "title": "Номер VLAN",
          "description": "Тег VLAN у діапазоні 1–4094 (унікальний у межах сайту, E002)."
        },
        "name": {
          "title": "Назва сегмента",
          "description": "Технічна назва сегмента, унікальна в межах сайту; на неї посилаються політики (E003).",
          "$ref": "#/$defs/identifier"
        },
        "role": {
          "title": "Роль сегмента",
          "description": "Призначення сегмента: mgmt — мережа керування (ціль перевірки E006), users, servers, guest (W001).",
          "enum": ["mgmt", "users", "servers", "guest"]
        },
        "cidr": { "$ref": "#/$defs/cidr" },
        "gateway": {
          "title": "Шлюз сегмента",
          "description": "IP шлюза за замовчуванням. Має належати cidr і лежати поза dhcp_pool (E007).",
          "$ref": "#/$defs/ipv4"
        },
        "dhcp_pool": {
          "title": "Пул DHCP",
          "$ref": "#/$defs/dhcp_pool"
        },
        "isolated": {
          "type": "boolean",
          "title": "Ізольований сегмент",
          "description": "true — трафік сегмента ізольовано (типово для guest)."
        }
      }
    },
    "dhcp_pool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "description": "Діапазон видачі DHCP. Обидві межі мають належати cidr сегмента (E007).",
      "properties": {
        "from": {
          "title": "Початок діапазону",
          "$ref": "#/$defs/ipv4"
        },
        "to": {
          "title": "Кінець діапазону",
          "$ref": "#/$defs/ipv4"
        }
      }
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "role", "mgmt_ip"],
      "properties": {
        "name": {
          "title": "Імʼя пристрою",
          "$ref": "#/$defs/identifier"
        },
        "type": {
          "title": "Тип пристрою",
          "description": "Цільова платформа бекенда: mikrotik (RouterOS), arista_eos або cisco_ios.",
          "enum": ["mikrotik", "arista_eos", "cisco_ios"]
        },
        "os_version": {
          "type": "string",
          "minLength": 1,
          "title": "Версія ОС пристрою",
          "description": "Напр. '6.48' для RouterOS. Визначає набір підтримуваних можливостей платформи (W002)."
        },
        "role": {
          "title": "Роль пристрою",
          "description": "Призначення у топології.",
          "enum": ["edge_router", "access_switch", "core_switch", "distribution_switch", "firewall"]
        },
        "mgmt_ip": {
          "title": "Management-адреса",
          "description": "IP керування; має належати мережі з роллю mgmt (E004).",
          "$ref": "#/$defs/ipv4"
        }
      }
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "role", "ip"],
      "properties": {
        "name": {
          "title": "Імʼя сервера",
          "$ref": "#/$defs/identifier"
        },
        "role": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "title": "Ролі сервера",
          "description": "Одна або кілька ролей навантаження.",
          "items": {
            "enum": ["docker_host", "monitoring", "app"]
          }
        },
        "ip": {
          "title": "IP-адреса сервера",
          "$ref": "#/$defs/ipv4"
        }
      }
    },
    "policies": {
      "type": "object",
      "additionalProperties": false,
      "description": "Політики, що описують дозволений/заборонений трафік. За замовчуванням між VLAN діє default-deny — правила лише відкривають потрібне (E005).",
      "properties": {
        "inter_vlan": {
          "type": "array",
          "title": "Правила міжмережевого доступу",
          "items": { "$ref": "#/$defs/inter_vlan_rule" }
        }
      }
    },
    "inter_vlan_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "action"],
      "properties": {
        "from": {
          "type": "string",
          "minLength": 1,
          "title": "Джерело",
          "description": "Назва мережі-джерела або 'any'."
        },
        "to": {
          "type": "string",
          "minLength": 1,
          "title": "Призначення",
          "description": "Назва мережі-призначення або 'any'."
        },
        "ports": {
          "type": "array",
          "title": "TCP/UDP-порти",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          }
        },
        "action": {
          "title": "Дія",
          "enum": ["allow", "deny"]
        },
        "except": {
          "type": "string",
          "title": "Виняток",
          "description": "Напр. 'internet' — дозволити лише вихід в інтернет."
        }
      }
    },
    "modules": {
      "type": "object",
      "additionalProperties": false,
      "description": "Прапорці вмикання функціональних модулів. Кожен вмикається незалежно.",
      "properties": {
        "network_fabric": {
          "type": "boolean",
          "title": "Network Fabric",
          "description": "VLAN, ACL/firewall, VPN; MikroTik RouterOS та Arista EOS з коду."
        },
        "security_observability": {
          "type": "boolean",
          "title": "Security & Observability",
          "description": "Prometheus/Grafana/Loki, збір метрик і логів."
        }
      }
    }
  }
}
