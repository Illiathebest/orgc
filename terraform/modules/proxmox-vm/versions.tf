###############################################################################
# proxmox-vm — піннінг версій OpenTofu та провайдера.
#
# Модуль НЕ конфігурує провайдера (provider "proxmox" {...}) — це відповідальність
# середовища (terraform/environments/<env>). Тут лише вимоги до версій, щоб
# середовища успадковували єдиний контракт (відтворюваність — принцип роботи M2).
#
# Провайдер bpg/proxmox — pre-1.0 (мінорна версія може ламати сумісність),
# тому фіксуємо діапазон патчів одного мінору: ">= 0.109.0, < 0.110.0".
# Підняття мінору — свідомий крок із перевіркою CHANGELOG, окремим MR.
###############################################################################

terraform {
  required_version = ">= 1.12.0, < 2.0.0"

  required_providers {
    proxmox = {
      source  = "bpg/proxmox"
      version = "~> 0.109.0"
    }
  }
}
